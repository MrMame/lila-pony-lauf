{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "defaultMode": "plan",
    "allow": [
      "Read(./src/**)",
      "Read(./node_modules/**)",
      "Read(./public/**)",
      "Read(./package.json)",
      "Read(./angular.json)",
      "Read(./tsconfig*.json)",
      "Write(./src/**)",
      "Write(./public/**)",
      "Edit(./src/**)",
      "Edit(./public/**)",
      "Read(./e2e/**)",
      "Read(./docs/**)",
      "Read(./.claude/**)",
      "Read(./.github/**)",
      "Read(./coverage/**)",
      "Read(./vitest.config.ts)",
      "Read(./playwright.config.ts)",
      "Read(./docs/project-logs/ai-implementations-log.md)",
      "Edit(./e2e/**)",
      "Edit(./docs/**)",
      "Edit(./.claude/rules/**)",
      "Edit(./.github/instructions/**)",
      "Edit(./angular.json)",
      "Edit(./package.json)",
      "Edit(./playwright.config.ts)",
      "Edit(./docs/project-logs/ai-implementations-log.md)",
      "Bash(npx playwright *)",
      "Bash(npm run e2e*)",
      "Bash(npm run test *)",
      "Bash(npm run lint)",
      "Bash(git mv *)",
      "Bash(ng serve)",
      "Bash(ng build)",
      "Bash(ng test --*)",
      "Bash(ng lint)",
      "Bash(npx tsc --noEmit)",
      "Bash(git status)",
      "Bash(git diff *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(node scripts/claude/work-statistics.mjs*)",
      "Bash(node --test scripts/claude/*)"
    ],
    "deny": [
      "Read(./.env*)",
      "Read(./secrets/**)",
      "Read(./docs/notes-human/**)",
      "Read(./dist/**)",
      "Read(./build/**)",
      "Bash(npm install *)",
      "Bash(git push *)",
      "Bash(rm -rf *)"
    ]
  }
}
